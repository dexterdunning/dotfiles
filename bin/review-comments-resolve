#!/usr/bin/env python3
"""Remove addressed comments from .review.local.jsonl."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# Allow sibling import when run as a script.
sys.path.insert(0, str(Path(__file__).resolve().parent))
from _review_comments_lib import comments_path, git_root, load_comments, write_comments  # noqa: E402


def resolve(path: str, line: int) -> int:
    root = git_root()
    file_path = comments_path(root)
    comments = load_comments(file_path)
    if not comments:
        return 0

    kept: list[dict] = []
    removed = 0
    for item in comments:
        if item["path"] == path and int(item["line"]) == line:
            removed += 1
        else:
            kept.append(item)

    write_comments(file_path, kept)
    return removed


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Remove a local review comment after it has been addressed.",
    )
    parser.add_argument("path", help="Repo-relative file path (as shown in review-comments-export)")
    parser.add_argument("line", type=int, help="1-based line number")
    args = parser.parse_args()

    removed = resolve(args.path, args.line)
    if removed == 0:
        print(f"review-comments-resolve: no comment for {args.path}:{args.line}", file=sys.stderr)
        raise SystemExit(1)
    print(f"review-comments-resolve: removed {removed} comment(s) for {args.path}:{args.line}")


if __name__ == "__main__":
    main()
