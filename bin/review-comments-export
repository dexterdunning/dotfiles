#!/usr/bin/env python3
"""Format .review.local.jsonl from the current git worktree as markdown."""

from __future__ import annotations

import subprocess
import sys
from collections import defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _review_comments_lib import comments_path, git_root, load_comments  # noqa: E402


def format_markdown(comments: list[dict], root: Path) -> str:
    if not comments:
        return "_No local review comments (.review.local.jsonl is empty)._"

    branch = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        check=False,
        capture_output=True,
        text=True,
    ).stdout.strip()

    lines = [
        "# Local review comments",
        "",
        f"- **Worktree:** `{root}`",
    ]
    if branch:
        lines.append(f"- **Branch:** `{branch}`")
    lines.append(f"- **Count:** {len(comments)}")
    lines.append("")

    by_path: dict[str, list[dict]] = defaultdict(list)
    for item in comments:
        by_path[item["path"]].append(item)

    for path in sorted(by_path):
        lines.append(f"## `{path}`")
        lines.append("")
        for item in sorted(by_path[path], key=lambda c: c["line"]):
            meta = []
            if item.get("ts"):
                meta.append(item["ts"])
            if item.get("source"):
                meta.append(item["source"])
            meta_suffix = f" ({', '.join(meta)})" if meta else ""
            lines.append(f"### Line {item['line']}{meta_suffix}")
            lines.append("")
            lines.append(item.get("text", "").rstrip())
            lines.append("")
            lines.append(
                f"_Resolve after fix:_ `review-comments-resolve {item['path']} {item['line']}`"
            )
            lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main() -> None:
    root = git_root()
    comments = load_comments(comments_path(root))
    sys.stdout.write(format_markdown(comments, root))


if __name__ == "__main__":
    main()
